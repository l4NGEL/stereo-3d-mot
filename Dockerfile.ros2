# ROS2 build/runtime environment for stereo_3d_mot's Phase 8 wrapper
# (ros2/s3m_ros2). Separate from the main Dockerfile for the same reason
# Dockerfile.gpu is separate: rclcpp/colcon are a genuinely different
# toolchain from the plain-CMake build every other app in this repo uses,
# and this way the main image never needs to carry ROS2 just to build the
# library and its own apps/tests.
FROM ros:humble-ros-base AS deps-ros2

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        curl \
        git \
        ca-certificates \
        pkg-config \
        libopencv-dev \
        libeigen3-dev \
        ros-humble-cv-bridge \
        ros-humble-vision-msgs \
        ros-humble-message-filters \
        python3-colcon-common-extensions \
    && rm -rf /var/lib/apt/lists/*

# ONNX Runtime (CPU) -- same tarball as the main Dockerfile, so
# perception_node's detector path is real, not stubbed out for this image.
ARG ORT_VERSION=1.19.2
RUN curl -fsSL -o /tmp/ort.tgz \
        "https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-x64-${ORT_VERSION}.tgz" \
    && mkdir -p /opt/onnxruntime \
    && tar -xzf /tmp/ort.tgz -C /opt/onnxruntime --strip-components=1 \
    && rm /tmp/ort.tgz
ENV ONNXRUNTIME_ROOT=/opt/onnxruntime \
    LD_LIBRARY_PATH=/opt/onnxruntime/lib

WORKDIR /ros2_ws

CMD ["/bin/bash"]
